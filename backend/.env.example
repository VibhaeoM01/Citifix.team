# Email Configuration for CitiFix
# Copy this file to .env and update with your email credentials

# === METHOD 1: OAuth2 (Most Secure - Recommended for Production) ===
# Gmail OAuth2 Configuration
EMAIL_USER=Citifix@12345
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# === METHOD 2: App Password (Simple - Good for Development) ===
# Gmail App Password Configuration (fallback)
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASS=your-16-digit-app-password

# === METHOD 3: Other Email Providers ===
# Outlook/Hotmail
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASS=your-password

# Custom SMTP
# EMAIL_HOST=smtp.yourprovider.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@domain.com
# EMAIL_PASS=your-password
# EMAIL_SECURE=false

# Email Validation Settings
EMAIL_REQUIRE_TRUSTED_PROVIDERS=false
EMAIL_ENABLE_MX_CHECK=true
EMAIL_BLOCK_DISPOSABLE=true

# Application Settings
NODE_ENV=development
PORT=5001

# === SETUP INSTRUCTIONS ===

# METHOD 1 - OAuth2 Setup (Recommended):
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a new project or select existing one
# 3. Enable Gmail API
# 4. Create OAuth2 credentials (Desktop application)
# 5. Get Client ID and Client Secret
# 6. Use OAuth2 Playground to get refresh token:
#    - Go to https://developers.google.com/oauthplayground
#    - Select Gmail API v1 -> https://www.googleapis.com/auth/gmail.send
#    - Authorize and get refresh token

# METHOD 2 - App Password Setup (Simple):
# 1. Enable 2-factor authentication on Gmail
# 2. Go to Google Account Settings > Security > App passwords
# 3. Generate a password for "Mail" and use it as EMAIL_PASS
# 4. Use your Gmail address as EMAIL_USER

# Email Validation Features:
# - Format validation
# - Disposable email detection
# - MX record verification
# - Trusted provider checking
# - Real-time validation